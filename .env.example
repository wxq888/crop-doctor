# ============================================
# 作物医生 CropDoctor · 环境变量模板
# 复制为 .env 后填写，.env 不入库
# ============================================

# ===== 应用 =====
APP_ENV=dev
APP_SECRET_KEY=change-me-to-a-random-string

# ===== 数据库 =====
MYSQL_ROOT_PASSWORD=devpass
DATABASE_URL=mysql+pymysql://root:devpass@localhost:3306/crop_doctor
REDIS_URL=redis://localhost:6379/0

# ===== LLM（智能客服）=====
# DeepSeek 开放平台申请：https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# ===== Embedding（RAG 向量化）=====
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# ===== YOLO 检测模型 =====
# 训练完成后把权重放到 ml/exports/ 下并在此指定
YOLO_WEIGHTS_PATH=ml/exports/best.pt
YOLO_CONF_THRESHOLD=0.35
