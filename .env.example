# ============================================
# 作物医生 CropDoctor · 环境变量模板
# 复制为 .env 后填写，.env 不入库
# ============================================

# ===== 应用 =====
APP_ENV=dev
APP_SECRET_KEY=change-me-to-a-random-string

# ===== JWT（签名密钥复用上面的 APP_SECRET_KEY，不另设）=====
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080        # 7 天

# ===== 文件上传 =====
UPLOAD_DIR=backend/uploads               # 原图/标注图/热力图根目录
MAX_UPLOAD_MB=10                         # 单张图片大小上限

# ===== 数据库 =====
MYSQL_ROOT_PASSWORD=devpass
DATABASE_URL=mysql+pymysql://root:devpass@localhost:3306/crop_doctor
REDIS_URL=redis://localhost:6379/0

# ===== LLM（智能客服）=====
# DeepSeek 开放平台申请：https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# ===== Embedding（RAG 向量化）=====
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# ===== 知识库数据链路（kb/ 采集与一病一档）=====
# huggingface.co 不可达，必须走镜像
HF_ENDPOINT=https://hf-mirror.com
# 关闭 hf-xet（hf-mirror 不代理 Xet 后端，开启会导致模型下载极慢：约 25min → 28s）
HF_HUB_DISABLE_XET=1
KB_DISEASES_DIR=kb/diseases
KB_CLASS_MAP_PATH=kb/class-map.json
FAISS_INDEX_DIR=kb/index

# ===== RAG 检索参数 =====
RAG_TOP_K=8                          # 检索返回条数（P2：4→8，覆盖「用药/防治」混合意图）
RAG_MIN_SCORE=0.35                   # 余弦相似度下限
# query 侧指令前缀（BGE 中文 s2p 推荐）；置空即关闭
RAG_QUERY_INSTRUCTION=为这个句子生成表示以用于检索相关文章：
RAG_CHUNK_MAX_CHARS=600              # 单 chunk 上限（超长再按句切）
RAG_CHUNK_OVERLAP_CHARS=60           # 超长二次切分重叠字数
EMBEDDING_BATCH_SIZE=32              # 编码批大小

# ===== LLM 生成参数（chat 后端）=====
LLM_TIMEOUT_SECONDS=60               # DeepSeek 单次超时
LLM_MAX_TOKENS=800                   # 单次生成上限
LLM_TEMPERATURE=0.3                  # 生成温度
CHAT_CONTEXT_MESSAGES=8              # 携带历史消息条数
# Moonshot Kimi 为推理模型，需关闭「思考」输出（true=关闭思考链，仅返回正文；非推理模型可设 false）
LLM_DISABLE_THINKING=true

# ===== YOLO 检测模型 =====
# 训练完成后把权重放到 ml/exports/ 下并在此指定
YOLO_WEIGHTS_PATH=ml/exports/yolo11s-plantvillage38-v1.pt
YOLO_CONF_THRESHOLD=0.35

# ===== 可解释性（Grad-CAM 热力图）=====
# ResNet50 旁支模型，检测详情页异步生成病斑热力图
RESNET_WEIGHTS_PATH=ml/exports/resnet50-plantvillage39-v1.pt
GRADCAM_ENABLED=true

# ===== 病害严重度分级（规则引擎阈值，可调）=====
# 病斑数量阈值：超过则升级；面积占比阈值：病斑像素和 / 图片面积
SEVERITY_SPOT_COUNT_MINOR=2
SEVERITY_SPOT_COUNT_MODERATE=5
SEVERITY_AREA_RATIO_MODERATE=0.05
SEVERITY_AREA_RATIO_SEVERE=0.15

# ===== 天气服务（施药建议联动）=====
# 和风天气免费开发版申请：https://dev.qweather.com
WEATHER_API_KEY=
WEATHER_BASE_URL=https://devapi.qweather.com
WEATHER_LOCATION=101010100          # 默认位置（北京），可被用户定位覆盖
WEATHER_CACHE_TTL=3600              # Redis 缓存秒数

# ===== 预警（warning 模块）=====
WARNING_ENABLED=true                     # 定时刷新总开关
WARNING_REFRESH_INTERVAL_MINUTES=360     # 后台刷新周期（分钟，默认 6h）
WARNING_FORECAST_DAYS=3                  # 参与评估的预报天数（≤3）
# 多条件叠加提权：true=温度·湿度·降雨·作物 四维齐全才保留原级别，声明不全则降一级（low 再降则不生成）
# false=回退旧行为（命中即按规则原级别，不降级）
WARNING_REQUIRE_FULL_DIMENSIONS=true

# ===== 实时监控事件总线（monitor 模块）=====
MONITOR_REDIS_CHANNEL=cropdoctor:monitor:events   # Redis Pub/Sub 频道
MONITOR_RECENT_KEY=cropdoctor:monitor:recent      # 事件快照 LIST 键（断线补拉）
MONITOR_RECENT_MAX=50                    # 快照保留条数
MONITOR_HEARTBEAT_SECONDS=25             # 服务端 WS 心跳间隔（秒）
MONITOR_MAX_CONNECTIONS=20               # 单进程最大 WS 连接数

# ===== 知识库重新向量化（knowledge 模块）=====
KB_REINDEX_TIMEOUT_SECONDS=300           # 重建索引子进程超时（秒）
